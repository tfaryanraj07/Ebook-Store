{
  "name": "ebook-store-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,FRONTEND\" -c \"blue,green\" \"npm run server\" \"npm run frontend\"",
    "start": "concurrently -n \"SERVER,FRONTEND\" -c \"blue,green\" \"npm run server\" \"npm run frontend\"",
    "server": "npm --prefix ebook-store/server run dev",
    "server:start": "npm --prefix ebook-store/server start",
    "frontend": "npm --prefix ebook-store/frontend run dev",
    "frontend:build": "npm --prefix ebook-store/frontend run build",
    "seed": "npm --prefix ebook-store/server run seed",
    "install:all": "npm --prefix ebook-store/server install && npm --prefix ebook-store/frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
